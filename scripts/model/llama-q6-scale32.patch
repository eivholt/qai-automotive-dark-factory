--- a/ggml/src/ggml-vulkan/vulkan-shaders/q6_scale32.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/q6_scale32.glsl
@@ -0,0 +1,10 @@
+// Private diagnostic: read signed Q6_K scale bytes through packed16 storage.
+// The Q6_K memory format and all mathematical scale values are unchanged.
+#ifndef PRIVATE_Q6_SCALE32
+#define PRIVATE_Q6_SCALE32
+int q6_scale32(uint block_index, uint scale_index) {
+    uint packed = uint(data_a_packed16[block_index].scales[scale_index / 2u]) & 65535u;
+    int encoded = int((packed >> ((scale_index & 1u) * 8u)) & 255u);
+    return (encoded ^ 128) - 128;
+}
+#endif
