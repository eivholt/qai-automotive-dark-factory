{
  "FileVersion": 3,
  "EngineAssociation": "5.8",
  "Category": "Simulation",
  "Description": "Automotive panel assembly with NIR and thermal model inspection gates",
  "Modules": [
    {
      "Name": "DarkFactory",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
    {
      "Name": "DarkFactoryAuthoring",
      "Enabled": true,
      "TargetAllowList": ["Editor"]
    },
    {
      "Name": "ModelContextProtocol",
      "Enabled": true,
      "TargetAllowList": ["Editor"]
    },
    {
      "Name": "AllToolsets",
      "Enabled": false,
      "TargetAllowList": ["Editor"]
    },
    {
      "Name": "PythonScriptPlugin",
      "Enabled": true
    },
    {
      "Name": "EditorScriptingUtilities",
      "Enabled": true
    },
    {
      "Name": "DLSS",
      "Enabled": true,
      "MarketplaceURL": "https://www.unrealengine.com/marketplace/en-US/product/nvidia-dlss",
      "Optional": true
    }
  ]
}
